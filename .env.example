# Controllarr — written by install.sh; this file documents every value.
# Your services' addresses and API keys are NOT here: they live in <CONTROLLARR_DATA>/controllarr.env (mode 600).

STACK_NAME=controllarr
TZ=Australia/Sydney

# Where Controllarr keeps its own state: accounts, sessions, live settings, the poster cache and
# controllarr.env. Nothing else writes here, and it is the only thing worth backing up.
CONTROLLARR_DATA=./config

# The port on this host. The container always listens on 3002.
CONTROLLARR_PORT=3002

# Seconds between library scans (each pass costs a few searches in Radarr/Sonarr).
CONTROLLARR_REFRESH=15
