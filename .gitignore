# --- per-install runtime (never commit) ---
.env
config/
docker-compose.override.yml
install-*.log
uninstall-*.log

# --- AI-assistant working files (owner: the repo stays clean for anyone who clones it) ---
# Personal instructions and assistant state stay out; the shared, public version of anything an
# assistant needs is docs/DEVELOPMENT.md. Three things under .claude/ ARE tracked because they
# are project plumbing, not private notes: the startup hook, the settings that register it, and
# the launcher the MCP servers in .mcp.json run through.
# (A directory ignored as `.claude/` cannot have its contents un-ignored — hence `.claude/*`.)
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/mcp/
CLAUDE.md
CLAUDE.local.md

# --- test tooling (tests/ and the Playwright config ARE committed; their outputs and deps are not) ---
node_modules/
test-results/
playwright-report/
.playwright-mcp/
tests/.harness.json
tests/local.env
.venv/
.ruff_cache/
__pycache__/

# a symlink here during development is still not part of the project
node_modules
